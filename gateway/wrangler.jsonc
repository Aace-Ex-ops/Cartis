{
  "name": "cartis-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "540329106cb74e56a5a2c659ccb98b49" }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "../ui/out",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*"]
  },
  "vars": {
    "YODLEE_BASE_URL": "https://sandbox.api.yodlee.com/ysl",
    "YODLEE_FASTLINK_URL": "https://fl4.sandbox.yodlee.com/authenticate/restserver/fastlink",
    "YODLEE_CONFIG_NAME": "Aggregation"
  },
  "routes": [
    { "pattern": "cartis.dpdns.org/*", "zone_id": "12c93c063d628e35c8800043a1af33f6" }
  ],
  "triggers": {
    "crons": ["30 5 * * *"]
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "cartis-gateway-preview",
      "kv_namespaces": [
        { "binding": "SESSIONS", "id": "540329106cb74e56a5a2c659ccb98b49" }
      ],
      "ai": {
        "binding": "AI"
      },
      "vars": {
        "YODLEE_BASE_URL": "https://sandbox.api.yodlee.com/ysl",
        "YODLEE_FASTLINK_URL": "https://fl4.sandbox.yodlee.com/authenticate/restserver/fastlink",
        "YODLEE_CONFIG_NAME": "Aggregation"
      },
      "routes": [],
      "triggers": {
        "crons": []
      }
    }
  }
}
