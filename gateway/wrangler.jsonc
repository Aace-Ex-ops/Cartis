{
  "name": "cartis-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "540329106cb74e56a5a2c659ccb98b49" },
    { "binding": "PROFILES", "id": "c37cdfa19ed6400db7f24e5806343276" }
  ],
  "vectorize": [
    { "binding": "COACH_EMBEDDINGS", "index_name": "coach-embeddings" }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "../ui/out",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*"]
  },
  "vars": {
    "YODLEE_BASE_URL": "https://sandbox.api.yodlee.com/ysl",
    "YODLEE_FASTLINK_URL": "https://fl4.sandbox.yodlee.com/authenticate/restserver/fastlink",
    "YODLEE_CONFIG_NAME": "Aggregation"
  },
  "routes": [
    { "pattern": "cartis.dpdns.org/*", "zone_id": "12c93c063d628e35c8800043a1af33f6" }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
